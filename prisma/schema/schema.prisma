// Base Prisma config. This file is created once and should not need edits
// when new entities are added — each entity gets its own file in this folder
// (e.g. prisma/schema/Product.prisma) generated by `npm run generate:entity`.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
